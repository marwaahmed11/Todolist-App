{
  "name": "mern-todolist-agentic",
  "version": "1.0.0",
  "description": "MERN Stack TodoList with Agentic AI Repair Agent",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn server/index.ts",
    "dev:client": "react-scripts start",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc server/**/*.ts --outDir dist/server",
    "build:client": "react-scripts build",
    "test": "jest",
    "test:server": "jest --selectProjects=server --watch",
    "test:client": "jest --selectProjects=client --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "agent": "npx ts-node agentic-mern.ts",
    "agent:watch": "npx ts-node-dev agentic-mern.ts",
    "agent:debug": "DEBUG=* npx ts-node agentic-mern.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@langchain/google-genai": "^0.0.22",
    "@octokit/rest": "^20.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "adm-zip": "^0.5.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.0",
    "react-scripts": "5.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "zod": "^3.12.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
